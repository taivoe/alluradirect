{
  "compilerOptions": {
    "outDir": "lib/esm",
    "module": "commonjs",
    "target": "ES6",
    "lib": ["es6", "dom", "es2016", "es2017", "ESNext"],
    "jsx": "react-jsx",
    "types": ["jest", "node", "react"],
    "declaration": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "**/index.ts", "src/customReact/validationSchemas/index.ts"]
}
